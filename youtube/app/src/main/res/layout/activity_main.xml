<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Premium Navigation Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_glass_topbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/icon_tint" />

            <!-- Forward Button -->
            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_forward"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/icon_tint" />

            <!-- Reload Button -->
            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_refresh"
                android:padding="8dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/icon_tint" />

            <!-- URL / Domain Indicator Pill -->
            <LinearLayout
                android:id="@+id/layoutDomainPill"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_indicator"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/imgShieldStatus"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/ad_shield_status"
                    android:src="@drawable/ic_shield_active" />

                <TextView
                    android:id="@+id/tvCurrentDomain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="m.youtube.com"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvBlockedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_indicator"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="Shield"
                    android:textColor="@color/shield_active"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Home Button -->
            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_home"
                android:padding="8dp"
                android:src="@drawable/ic_home"
                app:tint="@color/icon_tint" />

            <!-- Settings Button (Required by user prompt) -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_settings"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/spotify_green" />

        </LinearLayout>

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/pageProgressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/bg_chip_selected"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <!-- WebView Container -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/dockMiniPlayer"
            app:layout_constraintTop_toBottomOf="@id/pageProgressBar" />

        <!-- Fullscreen Container for HTML5 Video -->
        <FrameLayout
            android:id="@+id/fullscreenContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_black"
            android:visibility="gone" />

        <!-- Spotify-style Floating Bottom Dock / Mini-Player -->
        <androidx.cardview.widget.CardView
            android:id="@+id/dockMiniPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <!-- Thumbnail -->
                <ImageView
                    android:id="@+id/imgMiniThumb"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_url_box"
                    android:contentDescription="Artwork"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music_note" />

                <!-- Title & Artist -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMiniTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:fontFamily="sans-serif-medium"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:text="Now Playing"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMiniArtist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="AuraPlay"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvLowDataBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pill_indicator"
                            android:paddingStart="4dp"
                            android:paddingTop="1dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="1dp"
                            android:text="Audio Stream"
                            android:textColor="@color/spotify_green_light"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Mini Prev/Seek Button -->
                <ImageButton
                    android:id="@+id/btnMiniPrev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/media_action_prev"
                    android:padding="6dp"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/icon_tint" />

                <!-- Mini Play/Pause Button -->
                <ImageButton
                    android:id="@+id/btnMiniPlayPause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_play_button"
                    android:contentDescription="@string/media_action_play"
                    android:padding="8dp"
                    android:src="@drawable/ic_pause"
                    app:tint="@color/bg_black" />

                <!-- Mini Next/Seek Button -->
                <ImageButton
                    android:id="@+id/btnMiniNext"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/media_action_next"
                    android:padding="6dp"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/icon_tint" />

                <!-- Mini Close Button -->
                <ImageButton
                    android:id="@+id/btnMiniClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/media_action_stop"
                    android:padding="6dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/icon_tint_secondary" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
